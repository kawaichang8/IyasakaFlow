# ==============================================
# Iyasaka Flow 環境変数テンプレート
# ==============================================
# このファイルを .env.local にコピーして使用してください
# cp .env.example .env.local

# ----------------------------------------------
# アプリケーション設定
# ----------------------------------------------
NEXT_PUBLIC_APP_NAME="Iyasaka Flow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ----------------------------------------------
# データベース設定（必須）
# ----------------------------------------------
# Next.js は .env.local を優先します。Supabase 利用時は .env と .env.local の
# 両方に同じ DATABASE_URL を設定してください（ログイン・API が同じ DB を参照します）。
# PostgreSQL接続URL
# ローカル開発: postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Docker: postgresql://postgres:postgres@localhost:5432/crm_app
# Supabase/Neon: postgresql://[user]:[password]@[host]/[database]

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_app"

# 接続プール設定（本番環境用）
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ----------------------------------------------
# 認証設定（NextAuth.js v5）
# ----------------------------------------------
# NextAuth.js シークレット（必須）
# 生成コマンド: openssl rand -base64 32
AUTH_SECRET=""

# 本番環境用URL（公開時は必ず設定）
# Vercel/Railway などデプロイ後のURL（例: https://your-app.vercel.app）
# AUTH_URL="https://your-domain.com"

# ----------------------------------------------
# OAuth プロバイダー
# ----------------------------------------------
# Google OAuth
# 設定方法: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth（オプション）
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ----------------------------------------------
# メール送信設定
# ----------------------------------------------
# プロバイダー選択: "nodemailer" または "resend"
EMAIL_PROVIDER="nodemailer"

# Resend API（推奨）
# https://resend.com で取得
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="onboarding@resend.dev"
# RESEND_FROM_NAME="CRM App"

# SMTP (Nodemailer)
# Gmail、SendGrid、その他のSMTPサーバーに対応
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="CRM App"

# SendGrid SMTP経由での設定例
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"

# ----------------------------------------------
# 外部サービス連携（オプション）
# ----------------------------------------------
# Stripe（決済）
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# OpenAI（AI機能）
# OPENAI_API_KEY=""

# Google Calendar
# GOOGLE_CALENDAR_API_KEY=""

# Slack通知
# SLACK_WEBHOOK_URL=""

# ----------------------------------------------
# セキュリティ設定
# ----------------------------------------------
# 暗号化キー（本番環境では必須）
# ENCRYPTION_KEY=""  # 32バイトの暗号化キー

# レート制限
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------
# ログ・監視設定（オプション）
# ----------------------------------------------
# Sentry
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
